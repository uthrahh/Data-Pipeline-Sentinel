# Copy to .env.local for local development.
# Leaving these unset (or NEXT_PUBLIC_USE_LIVE_API unset/false) keeps the app
# on mock data — no behavior changes.

# --- Local dev: browser calls the backend directly ---
# Run the FastAPI backend locally first: cd ../Backend && uvicorn app:app --port 8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_LIVE_API=true

# --- Deployed (e.g. Vercel): do NOT point NEXT_PUBLIC_API_URL at the
# Databricks App URL directly — Databricks Apps require an authenticated
# Databricks caller, so a browser can't reach one anonymously. Instead, route
# through this app's own server-side proxy (src/app/api/proxy/[...path]),
# which exchanges a service-principal OAuth client id/secret for short-lived
# access tokens server-side. The browser never sees any Databricks credential.
#
#   NEXT_PUBLIC_API_URL=/api/proxy
#   NEXT_PUBLIC_USE_LIVE_API=true
#   DATABRICKS_HOST=https://dbc-fa603402-4338.cloud.databricks.com
#   DATABRICKS_APP_URL=https://sentinel-pipeline-backend-<id>.<region>.databricksapps.com
#   DATABRICKS_CLIENT_ID=<the app's service-principal application id>
#   DATABRICKS_CLIENT_SECRET=<OAuth secret generated for that service principal>
#
# Set these six as Vercel project environment variables, not in this file.
# Generate the client secret via the Databricks Admin Console (Settings ->
# Identity and access -> Service principals -> the app's principal ->
# Secrets -> Generate secret) — not via CLI/API, so the raw secret only ever
# appears in your own browser session.
