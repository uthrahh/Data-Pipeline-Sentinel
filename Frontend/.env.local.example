# Copy to .env.local for local development.
#
# Only Genie (the chat assistant) is live; everything else is static demo data.
# Locally the browser can call the assistant directly (no auth wall):
NEXT_PUBLIC_API_URL=http://localhost:8000

# When hosted as a Databricks App (see app.yaml) the browser must NOT call the
# assistant's URL directly — Databricks Apps require an authenticated caller.
# Use this app's own server-side proxy instead, which exchanges a
# service-principal OAuth client id/secret for short-lived tokens:
#
#   NEXT_PUBLIC_API_URL=/api/proxy
#   DATABRICKS_HOST=https://dbc-fa603402-4338.cloud.databricks.com
#   DATABRICKS_APP_URL=https://ai-dataops-assistant-<id>.<region>.databricksapps.com
#   DATABRICKS_CLIENT_ID=<service-principal application id>
#   DATABRICKS_CLIENT_SECRET=<OAuth secret for that service principal>
#
# In app.yaml the secret is injected with `valueFrom` from a Databricks secret
# scope resource — never commit it.
