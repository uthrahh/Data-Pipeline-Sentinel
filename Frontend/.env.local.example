# Copy to .env.local for local development.
# Leaving these unset (or NEXT_PUBLIC_USE_LIVE_API unset/false) keeps the app
# on mock data — no behavior changes.

# --- Local dev: browser calls the backend directly ---
# Run the FastAPI backend locally first: cd ../Backend && uvicorn app:app --port 8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_LIVE_API=true

# --- Deployed (e.g. Vercel): do NOT point NEXT_PUBLIC_API_URL at the
# Databricks App URL directly — Databricks Apps require an authenticated
# Databricks caller, so a browser can't reach one anonymously. Instead, route
# through this app's own server-side proxy (src/app/api/proxy/[...path]),
# which attaches a Databricks credential that never reaches the browser:
#
#   NEXT_PUBLIC_API_URL=/api/proxy
#   NEXT_PUBLIC_USE_LIVE_API=true
#   DATABRICKS_APP_URL=https://sentinel-pipeline-backend-<id>.<region>.databricksapps.com
#   DATABRICKS_APP_TOKEN=<token for the app's service principal — server-only, no NEXT_PUBLIC_ prefix>
#
# Set these four as Vercel project environment variables, not in this file.
